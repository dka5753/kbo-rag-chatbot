# --- LLM: ollama(로컬, 기본) | openai | anthropic ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- 임베딩: ollama | openai ---
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# --- 저장소 ---
DATABASE_URL=sqlite:///./kbo_jobs.db
# DATABASE_URL=postgresql+psycopg://kbo:kbo@localhost:5432/kbo

# --- 동작 ---
TOP_K=4
CODE_TIMEOUT_S=10
MAX_CODE_RETRIES=2
# 1이면 API 프로세스 안에서 워커도 같이 실행 (로컬 개발용)
EMBEDDED_WORKER=0
